    "import pandas as pd\n",
    "import scipy.io\n",
    "\n",
    "# 1. Load the .mat file\n",
    "mat_data = scipy.io.loadmat('data/EMG-data.mat')\n",
    "\n",
    "# 2. Filter out the MATLAB metadata keys\n",
    "# This leaves only your actual variables/matrices\n",
    "data_keys = [key for key in mat_data.keys() if not key.startswith('__')]\n",
    "\n",
    "# 3. Convert to a Pandas DataFrame\n",
    "# Case A: If you have a single 2D matrix you want as a dataframe\n",
    "matrix_name = data_keys[0] # Takes the first available data variable\n",
    "df = pd.DataFrame(mat_data[matrix_name])\n",
    "\n",
    "# Case B: If your .mat file contains multiple 1D arrays (columns)\n",
